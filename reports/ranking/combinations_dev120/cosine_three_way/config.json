{
  "eligibility": "job_zone in [4,5] and complete supplied RIASEC z-scores",
  "input_mode": "oracle",
  "occupations": "data/occupations.csv",
  "profiles": "data/dev_profiles.jsonl",
  "ranking": {
    "components": {
      "m1": {
        "algorithm": "cosine_similarity",
        "variant": "baseline_v1"
      },
      "m3": {
        "algorithm": "bm25",
        "variant": "baseline_v1"
      },
      "m4": {
        "algorithm": "minilm",
        "variant": "mean_tasks_v1"
      }
    },
    "fusion": {
      "algorithm": "rrf",
      "k": 60
    }
  },
  "ranking_depth": "full_pool",
  "resolved_ranking": {
    "components": {
      "m1": {
        "algorithm": "cosine_similarity",
        "component": "m1",
