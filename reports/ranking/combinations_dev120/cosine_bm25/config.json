{
  "eligibility": "job_zone in [4,5] and complete supplied RIASEC z-scores",
  "input_mode": "oracle",
  "occupations": "data/occupations.csv",
  "profiles": "data/dev_profiles.jsonl",
  "ranking": {
    "components": {
      "m1": {
        "algorithm": "cosine_similarity",
        "variant": "baseline_v1"
      },
      "m3": {
        "algorithm": "bm25",
        "variant": "baseline_v1"
      },
      "m4": null
    },
    "fusion": {
      "algorithm": "rrf",
      "k": 60
    }
  },
  "ranking_depth": "full_pool",
  "resolved_ranking": {
    "components": {
      "m1": {
        "algorithm": "cosine_similarity",
        "component": "m1",
        "parameters": {
          "dimension_order": [
            "R",
            "I",
            "A",
            "S",
            "E",
            "C"
          ],
          "normalization": "l2_both_vectors_on_observed_dimensions",
          "observed_only": true,
          "occupation_scale": "supplied_z_scores",
          "tie_break": "code_ascending",
          "zero_occupation_norm": "omit",
          "zero_user_norm": "unusable"
        },
        "variant": "baseline_v1"
      },
      "m3": {
        "algorithm": "bm25",
        "component": "m3",
        "parameters": {
          "b": 0.75,
          "document": "bm25_doc",
          "idf": "log1p((N-df+0.5)/(df+0.5))",
          "k1": 1.5,
          "positive_matches_only": true,
          "query": "all_user_utterances",
          "query_tf": "linear",
          "stemming": false,
          "stopwords": [
            "a",
